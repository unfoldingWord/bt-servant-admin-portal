{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bt-servant-admin-portal",
  "main": "./worker/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "ENGINE_BASE_URL": "https://api.btservant.ai",
    "BARUCH_BASE_URL": "https://baruch.btservant.ai",
    // #311 — BT Servant's WhatsApp number in E.164 (e.g. "+573001234567").
    // Empty = the Modes page shows "WhatsApp number not configured". The
    // worker's first-contact message (#311 part 2) will read a var of the
    // same name from its wrangler.toml; when it lands, change both together.
    // The CI workflows source the number from the GitHub Actions variable
    // WHATSAPP_NUMBER: deploy-pr.yml / deploy-staging.yml rewrite `vars`
    // wholesale on the built config (keep their lists in step with this
    // one); deploy-prod.yml injects it with `--var`, which wins over this
    // value. Local `--env` blocks below mirror the keys.
    "WHATSAPP_NUMBER": "",
    // Org the WhatsApp gateway is pinned to (gateway wrangler.toml ENGINE_ORG).
    "WHATSAPP_ORG": "unfoldingWord",
  },
  "services": [
    {
      "binding": "BARUCH",
      "service": "baruch",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "AUTH_KV",
      "id": "0fa90c7559164e96b3c2f182c10b13de",
    },
  ],
  "env": {
    "dev": {
      "name": "bt-servant-admin-portal-dev",
      "vars": {
        "ENGINE_BASE_URL": "https://staging-api.btservant.ai",
        "BARUCH_BASE_URL": "https://baruch-dev.unfoldingword.workers.dev",
        "WHATSAPP_NUMBER": "",
        "WHATSAPP_ORG": "unfoldingWord",
      },
      "services": [
        {
          "binding": "BARUCH",
          "service": "baruch-dev",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "AUTH_KV",
          "id": "fe1fdafdb04a4fa085b38c0a79e7a590",
        },
      ],
    },
    "staging": {
      "name": "bt-servant-admin-portal-staging",
      "vars": {
        "ENGINE_BASE_URL": "https://staging-api.btservant.ai",
        "BARUCH_BASE_URL": "https://staging-baruch.btservant.ai",
        "WHATSAPP_NUMBER": "",
        "WHATSAPP_ORG": "unfoldingWord",
      },
      "services": [
        {
          "binding": "BARUCH",
          "service": "baruch-staging",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "AUTH_KV",
          "id": "76b77b269f7c48b481f3448955950b57",
        },
      ],
    },
  },
}
